[Unit]
Description=Monga Cal - Smart Todo & AI Scheduler Daemon
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/monga-cal
ExecStart=/home/pi/monga-cal/venv/bin/python main.py
Restart=always
RestartSec=10
EnvironmentFile=/home/pi/monga-cal/.env

[Install]
WantedBy=multi-user.target
